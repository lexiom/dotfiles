# Global
Host *
  AddKeysToAgent yes
  ServerAliveCountMax 3
  ServerAliveInterval 60
  TCPKeepAlive yes
  UseKeychain yes

# LLM Agent
Host agent
  ForwardAgent no
  HostName localhost
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_agent
  User agent

# Personal GitHub
Host github-personal
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_personal
  User git

# Work GitHub
Host github-work
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_work
  User git
