# Global
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes
  UseKeychain yes

# Personal GitHub
Host github-personal
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_personal
  User git

# Work GitHub
Host github-work
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_work
  User git
