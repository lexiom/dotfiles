# Global
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes
  UseKeychain yes

# Personal GitHub
Host github-personal
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_personal
  User git

# Work GitHub
Host github-work
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_work
  User git

# Base VM
Host nix-base
  HostName 10.0.0.20
  User sysadmin
  PreferredAuthentications password
  PubkeyAuthentication no

# Personal VM
Host nix-personal
  ForwardAgent yes
  HostName 10.0.0.21
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_personal
  User sysadmin

# Work VM
Host nix-work
  ForwardAgent yes
  HostName 10.0.0.22
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_work
  User sysadmin
