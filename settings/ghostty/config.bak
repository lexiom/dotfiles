## cursor
adjust-cursor-height = -3
adjust-cursor-thickness = 3
cursor-color = #000000
cursor-invert-fg-bg = false
cursor-text = #f2f2f2

## font
font-family = "IosevkaTermSlab Nerd Font Mono"
font-feature = -calt
font-feature = -dlig
font-feature = -liga
font-size = 18
font-style = "Medium"
font-thicken = true
font-thicken-strength = 255
window-title-font-family = "IosevkaTermSlab Nerd Font Mono"

## keybindings
# keybind = cmd+k>j=new_tab
keybind = ctrl+shift+v=paste_from_clipboard

## key remaps
macos-option-as-alt = true
key-remap = super=alt

## layout
macos-titlebar-style = tabs
theme = "GrayscaleLight"
window-padding-x = 10

## shell
clipboard-read = allow
clipboard-write = allow
shell-integration-features = ssh-env
